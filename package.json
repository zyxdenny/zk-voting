{
  "name": "dao-voting-zk",
  "version": "1.2.0",
  "description": "Anonymous DAO voting with zk-SNARKs: identity commitments, circom circuit, Groth16 proofs, on-chain verification",
  "scripts": {
    "clean": "rm -rf ./circuits/build ./artifacts ./cache deployment.json contracts/Verifier.sol",
    "build": "mkdir -p ./circuits/build && circom ./circuits/circuit.circom --r1cs --wasm -o ./circuits/build",
    "setup": "mkdir -p ./circuits/build/keys && npx snarkjs groth16 setup ./circuits/build/circuit.r1cs powersOfTau28_hez_final_14.ptau ./circuits/build/keys/circuit_0000.zkey",
    "gen-vkey": "npx snarkjs zkey export verificationkey ./circuits/build/keys/circuit_0000.zkey ./circuits/build/keys/verification_key.json",
    "gen-contract": "npx snarkjs zkey export solidityverifier ./circuits/build/keys/circuit_0000.zkey ./contracts/Verifier.sol",
    "build-circuit": "npm run build && npm run setup && npm run gen-vkey && npm run gen-contract",
    "identity": "node ./scripts/createIdentity.js",
    "register": "node ./scripts/register.js",
    "registry": "node ./scripts/showRegistry.js",
    "compile": "npx hardhat compile",
    "node": "npx hardhat node",
    "deploy": "npx hardhat run scripts/deploy.js --network localhost",
    "vote": "npx hardhat run scripts/vote.js --network localhost",
    "results": "npx hardhat run scripts/results.js --network localhost",
    "verify": "node ./scripts/main.js",
    "test": "npx hardhat test"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "app-root-path": "^3.1.0",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "prompt-sync": "^4.2.0",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.24.0"
  }
}
